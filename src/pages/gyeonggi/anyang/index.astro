---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE } from "../../../lib/site";
import { getSido, sigungusBySido, stations } from "../../../lib/data";
import { breadcrumbSchema } from "../../../lib/seo";

const title = "안양 출장마사지｜범계·평촌·인덕원·안양역 홈타이 지역 안내";
const description = "안양 출장마사지·홈타이 예약 전 범계, 평촌, 인덕원, 안양역, 석수동, 호계동 생활권을 확인하세요.";

const schema = [
  breadcrumbSchema([{ name: "홈", path: "/" }, { name: "안양 안내", path: "/gyeonggi/anyang/" }]),
];

const anyang = getSido("anyang")!;
const districts = sigungusBySido("anyang");
const anyangStations = stations.filter((s) => s.sigunguSlug === "anyang").slice(0, 9);
---

<BaseLayout title={title} description={description} path="/gyeonggi/anyang/" schema={schema}>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="hero__badge"><span class="dot"></span> 바로 GO 전문</span>
      <h1>
        <span class="kw">안양 출장마사지 · 안양 홈타이</span>
        지역별 예약 안내
      </h1>
      <p class="hero__sub">
        범계, 평촌, 인덕원, 안양역, 석수동, 호계동 등 안양 주요 생활권별 방문 가능 지역과 예약 전 확인사항을 안내합니다.
      </p>
      <ul class="hero__points">
        <li>만안구·동안구 전역 방문</li>
        <li>신도시·원도심 전문 커버</li>
        <li>연중무휴 24시간 예약</li>
      </ul>
      <div class="hero__cta">
        <a class="btn btn--cta" href={SITE.phoneHref}>전화예약 {SITE.phone}</a>
        <a class="btn btn--line" href="/gyeonggi/anyang/gu/">구별 안내 보기</a>
        <a class="btn btn--line" href="/gyeonggi/anyang/station/">역으로 찾기</a>
      </div>
      <div class="hero__stats">
        <div><b>2</b><span>만안구·동안구</span></div>
        <div><b>16+</b><span>주요 동 생활권</span></div>
        <div><b>24h</b><span>연중무휴 예약</span></div>
      </div>
    </div>
  </section>

  <!-- 구별 안내 -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">구별 안내</span>
        <h2 class="section__title">만안구·동안구 생활권 차이</h2>
        <p class="section__lead">
          안양은 만안구와 동안구의 생활권이 다릅니다. 각 구별 특성을 확인하세요.
        </p>
      </div>
      <div class="grid grid--2">
        {
          districts.map((d) => (
            <a class="card" href={`/gyeonggi/anyang/gu/${d.regionSlug}/`}>
              <div class="card__title">
                {d.regionName} <span class="arrow">→</span>
              </div>
              <p class="card__desc">{d.contentFocus}</p>
              <div class="card__tags">
                {d.nearbyStations?.slice(0, 3).map((station) => (
                  <span class="tag">{station}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 지하철역으로 찾기 -->
  <section class="section section--soft">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">역세권으로 찾기</span>
        <h2 class="section__title">안양 주요 지하철역 안내</h2>
        <p class="section__lead">
          현재 위치의 가까운 지하철역을 기준으로 방문 가능 생활권을 확인하세요.
        </p>
      </div>
      <div class="grid grid--3">
        {
          anyangStations.map((st) => (
            <a class="card" href={`/gyeonggi/anyang/station/${st.stationSlug}/`}>
              <div class="card__title">{st.stationName}</div>
              <p class="card__desc">
                {st.nearbyAreas?.slice(0, 2).join(', ')} 인접 생활권
              </p>
              <div class="card__tags">
                {st.nearbyAreas?.slice(0, 2).map((area) => (
                  <span class="tag">{area}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
      <div style="text-align:center;margin-top:24px">
        <a class="btn btn--line" href="/gyeonggi/anyang/station/">전체 역 보기</a>
      </div>
    </div>
  </section>

  <!-- 생활권 안내 -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">생활권 안내</span>
        <h2 class="section__title">안양 주요 생활권</h2>
        <p class="section__lead">
          범계, 평촌, 인덕원 신도시부터 안양역, 명학역 원도심까지 모든 생활권을 확인하세요.
        </p>
      </div>
      <div class="chip-list">
        {
          anyang.lifeAreas.map((area) => (
            <a class="chip" href={`/gyeonggi/anyang/life/`}>{area}</a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
