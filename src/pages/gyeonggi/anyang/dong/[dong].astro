---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { sigungusBySido, dongsOf, dongDetailFor } from "../../../../lib/data";
import { breadcrumbSchema, webPageSchema } from "../../../../lib/seo";

export async function getStaticPaths() {
  const districts = sigungusBySido("anyang");
  const paths: any[] = [];

  for (const district of districts) {
    const dongs = dongsOf("gyeonggi", district.regionSlug);
    for (const dong of dongs) {
      const detail = dongDetailFor("gyeonggi", district.regionSlug, dong.slug);
      if (detail) {
        paths.push({
          params: { dong: dong.slug },
          props: { district, dongSlug: dong.slug, dongName: dong.name },
        });
      }
    }
  }

  return paths;
}

const { dong } = Astro.params;
const { district, dongSlug, dongName } = Astro.props;

const detail = dongDetailFor("gyeonggi", district.regionSlug, dongSlug!);
if (!detail) return Astro.redirect("/gyeonggi/anyang/dong/");

const title = `${detail.name || dongName}｜안양`;
const description = detail.blurb || "";

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "지역별 안내", path: "/gyeonggi/anyang/dong/" },
    { name: detail.name || dongName, path: `/gyeonggi/anyang/dong/${dongSlug}/` },
  ]),
  webPageSchema(title, description, `/gyeonggi/anyang/dong/${dongSlug}/`),
];
---

<BaseLayout title={title} description={description} path={`/gyeonggi/anyang/dong/${dongSlug}/`} schema={schema}>
  <Breadcrumbs items={[
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "지역별 안내", path: "/gyeonggi/anyang/dong/" },
    { name: detail.name || dongName },
  ]} />

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">{district.regionName}</span>
        <h1 class="section__title">{detail.name}</h1>
        <p class="section__lead">{detail.blurb}</p>
      </div>

      <div style="margin-bottom:32px">
        <h2 style="margin-bottom:16px">특징</h2>
        <p style="font-size:1.1rem;font-weight:bold;color:#0a1730;margin-bottom:8px">{detail.character}</p>
      </div>

      <div style="margin-bottom:32px">
        <h2 style="margin-bottom:16px">가까운 지하철역</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {detail.nearbyStations.map((station) => (
            <span style="padding:8px 16px;background:#0a1730;color:#fff;border-radius:4px">{station}</span>
          ))}
        </div>
      </div>

      <div style="margin-bottom:32px">
        <h2 style="margin-bottom:16px">인접 지역</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {detail.adjacentAreas.map((area) => (
            <span style="padding:8px 12px;background:#f5f5f5;border-radius:4px">{area}</span>
          ))}
        </div>
      </div>

      <div style="margin-bottom:32px">
        <h2 style="margin-bottom:16px">주요 시설·상권</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {detail.landmarks.map((landmark) => (
            <span style="padding:8px 12px;background:#f0f7ff;border-radius:4px;color:#0a1730">{landmark}</span>
          ))}
        </div>
      </div>

      <div class="prose" style="line-height:1.8">
        <h2>지역 소개</h2>
        <p>{detail.p1}</p>

        <h2>방문 시 확인사항</h2>
        <p>{detail.p2}</p>

        <h2>예약 전 팁</h2>
        <p>{detail.p3}</p>
      </div>
    </div>
  </section>
</BaseLayout>
