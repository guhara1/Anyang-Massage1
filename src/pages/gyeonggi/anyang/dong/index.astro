---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { sigungusBySido, dongsOf } from "../../../../lib/data";
import { breadcrumbSchema } from "../../../../lib/seo";

const title = "지역별 안내｜안양 동 지역";
const description = "안양 출장마사지·홈타이 지역 안내. 안양시 모든 동의 생활권을 확인하세요.";

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "지역별 안내", path: "/gyeonggi/anyang/dong/" },
  ]),
];

const districts = sigungusBySido("anyang");
const allDongs = districts.flatMap((d) => {
  const dongs = dongsOf("anyang", d.regionSlug);
  return dongs.map((dong) => ({
    ...dong,
    district: d.regionName,
    districtSlug: d.regionSlug,
  }));
});
---

<BaseLayout title={title} description={description} path="/gyeonggi/anyang/dong/" schema={schema}>
  <Breadcrumbs items={[
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "지역별 안내" },
  ]} />

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">지역별 안내</span>
        <h1 class="section__title">안양 모든 동 안내</h1>
        <p class="section__lead">
          안양시의 모든 동을 확인하세요. 각 동의 생활권 특징과 근처 역, 상권 정보를 제공합니다.
        </p>
      </div>

      {
        districts.map((district) => (
          <div style="margin-bottom:48px">
            <h2 style="margin-bottom:24px;font-size:1.5rem">{district.regionName}</h2>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px">
              {
                dongsOf("anyang", district.regionSlug).map((dong) => (
                  <a
                    href={`/gyeonggi/anyang/dong/${dong.slug}/`}
                    style="padding:20px;border:1px solid #e0e0e0;border-radius:8px;text-decoration:none;transition:all 0.2s;cursor:pointer"
                  >
                    <div style="font-weight:bold;margin-bottom:8px;font-size:1.1rem">{dong.name}</div>
                    <p style="font-size:0.9rem;color:#666;margin:0">{dong.blurb}</p>
                  </a>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
