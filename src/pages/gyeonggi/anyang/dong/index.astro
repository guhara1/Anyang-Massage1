---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { anyangDongs } from "../../../../lib/data";
import { breadcrumbSchema } from "../../../../lib/seo";

const title = "지역별 안내｜안양 행정동 출장마사지 지역 안내";
const description = "안양 출장마사지·홈타이 지역 안내. 만안구·동안구 모든 행정동의 생활권을 확인하세요.";

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "지역별 안내", path: "/gyeonggi/anyang/dong/" },
  ]),
];

// 구별로 묶기 (만안구 → 동안구 순)
const all = anyangDongs();
const guOrder = ["manan-gu", "dongan-gu"];
const groups = guOrder.map((gu) => {
  const dongs = all
    .filter((d) => d.gu === gu)
    .sort((a, b) => a.name.localeCompare(b.name, "ko"));
  return { gu, guName: dongs[0]?.guName ?? gu, dongs };
});
---

<BaseLayout title={title} description={description} path="/gyeonggi/anyang/dong/" schema={schema}>
  <Breadcrumbs items={[
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "지역별 안내" },
  ]} />

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">지역별 안내</span>
        <h1 class="section__title">안양 행정동 지역별 안내</h1>
        <p class="section__lead">
          안양시 만안구·동안구의 모든 행정동을 확인하세요. 각 동의 생활권 특징과 가까운 역,
          인접 지역, 예약 전 확인사항을 안내합니다.
        </p>
      </div>

      {
        groups.map((group) => (
          <div style="margin-bottom:48px">
            <h2 style="margin-bottom:24px;font-size:1.5rem">{group.guName}</h2>
            <div class="grid grid--3">
              {group.dongs.map((dong) => (
                <a class="card" href={`/gyeonggi/anyang/${dong.gu}/${dong.slug}/`}>
                  <div class="card__title">
                    {dong.name} <span class="arrow">→</span>
                  </div>
                  <p class="card__desc">{dong.blurb}</p>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
