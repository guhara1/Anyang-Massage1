---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import PriceTable from "../../../../components/PriceTable.astro";
import { stations } from "../../../../lib/data";
import { breadcrumbSchema, webPageSchema, coursePriceSchema } from "../../../../lib/seo";

export async function getStaticPaths() {
  const anyangStations = stations.filter((s) => s.sigunguSlug === "anyang");
  return anyangStations.map((st) => ({
    params: { station: st.stationSlug },
  }));
}

const { station } = Astro.params;
const stationData = stations.find((s) => s.stationSlug === station && s.sigunguSlug === "anyang");

if (!stationData) return Astro.redirect("/gyeonggi/anyang/station/");

const title = `${stationData.stationName}｜안양`;
const description = stationData.contentFocus;

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "역세권 안내", path: "/gyeonggi/anyang/station/" },
    { name: stationData.stationName, path: `/gyeonggi/anyang/station/${station}/` },
  ]),
  webPageSchema(title, description, `/gyeonggi/anyang/station/${station}/`),
  coursePriceSchema(`안양 ${stationData.stationName}`, `/gyeonggi/anyang/station/${station}/`),
];
---

<BaseLayout title={title} description={description} path={`/gyeonggi/anyang/station/${station}/`} schema={schema}>
  <Breadcrumbs items={[
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "역세권 안내", path: "/gyeonggi/anyang/station/" },
    { name: stationData.stationName },
  ]} />

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">역세권 안내</span>
        <h1 class="section__title">{stationData.stationName}</h1>
        <p class="section__lead">{stationData.contentFocus}</p>
      </div>

      {stationData.transferYn && (
        <div style="margin-bottom:32px;padding:16px;background:#f0f7ff;border-radius:8px">
          <span style="font-weight:bold;color:#0a1730">환승역 정보</span>
          <p style="margin:8px 0 0 0;font-size:0.95rem">{stationData.transferLines?.join(", ")} 환승 가능</p>
        </div>
      )}

      <div style="margin-bottom:32px">
        <h2 style="margin-bottom:16px">인접 생활권</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
          {stationData.nearbyAreas?.map((area) => (
            <div style="padding:12px;background:#f5f5f5;border-radius:6px">
              <div style="font-weight:bold">{area}</div>
            </div>
          ))}
        </div>
      </div>

      <div style="margin-bottom:32px">
        <h2 style="margin-bottom:16px">주소</h2>
        <p>{stationData.address}</p>
      </div>

      <div class="prose">
        <h2>방문 전 확인사항</h2>
        <p>
          {stationData.stationName} 역세권에서 출장마사지·홈타이를 이용하실 경우,
          위의 인접 생활권과 주소 정보를 참고하여 정확한 위치를 미리 확인해 주세요.
          예약 시 역명과 출구, 가까운 건물이나 상가 이름을 함께 알려주시면
          도착이 더욱 수월합니다.
        </p>
        <p>
          특히 환승역이나 대규모 역세권은 시간대에 따라 혼잡도가 크게 달라질 수 있으므로,
          예약 전 전화로 정확한 도착 가능 시간을 문의해 주시기 바랍니다.
        </p>
      </div>
    </div>
  </section>

  <!-- 코스 요금 -->
  <PriceTable areaLabel={stationData.stationName} />
</BaseLayout>
