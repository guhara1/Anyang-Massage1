---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { stations } from "../../../../lib/data";
import { breadcrumbSchema } from "../../../../lib/seo";

const title = "역세권 안내｜안양 지하철역";
const description = "안양 출장마사지·홈타이 지하철역별 안내. 가까운 역을 선택해 방문 가능 생활권을 확인하세요.";

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "역세권 안내", path: "/gyeonggi/anyang/station/" },
  ]),
];

const anyangStations = stations.filter((s) => s.sigunguSlug === "anyang").sort((a, b) => a.stationName.localeCompare(b.stationName, "ko"));
---

<BaseLayout title={title} description={description} path="/gyeonggi/anyang/station/" schema={schema}>
  <Breadcrumbs items={[
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "역세권 안내" },
  ]} />

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">역세권 안내</span>
        <h1 class="section__title">안양 지하철역</h1>
        <p class="section__lead">
          가까운 지하철역을 선택해 방문 가능 생활권과 예약 시 확인사항을 확인하세요.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
        {
          anyangStations.map((station) => (
            <a
              href={`/gyeonggi/anyang/station/${station.stationSlug}/`}
              style="padding:24px;border:1px solid #e0e0e0;border-radius:8px;text-decoration:none;transition:all 0.2s;cursor:pointer"
            >
              <div style="font-weight:bold;margin-bottom:8px;font-size:1.2rem">{station.stationName}</div>
              <p style="font-size:0.9rem;color:#666;margin:8px 0">{station.contentFocus}</p>
              <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px">
                {station.nearbyAreas?.slice(0, 3).map((area) => (
                  <span style="font-size:0.85rem;padding:4px 8px;background:#f5f5f5;border-radius:3px">{area}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
