---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import PriceTable from "../../../../components/PriceTable.astro";
import { SITE } from "../../../../lib/site";
import { stations } from "../../../../lib/data";
import { breadcrumbSchema, coursePriceSchema } from "../../../../lib/seo";

const title = "역세권 안내｜안양 지하철역 출장마사지·홈타이";
const description = "안양 출장마사지·홈타이 지하철역별 안내. 명학역, 석수역, 관악역, 인덕원역 등 역별 방문 가능 생활권과 예약 방법을 확인하세요.";

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "역세권 안내", path: "/gyeonggi/anyang/station/" },
  ]),
  coursePriceSchema("안양 역세권", "/gyeonggi/anyang/station/"),
];

const anyangStations = stations.filter((s) => s.sigunguSlug === "anyang").sort((a, b) => {
  const priority = (b.indexPriority || 0) - (a.indexPriority || 0);
  return priority !== 0 ? priority : a.stationName.localeCompare(b.stationName, "ko");
});
---

<BaseLayout title={title} description={description} path="/gyeonggi/anyang/station/" schema={schema}>
  <Breadcrumbs items={[
    { name: "홈", path: "/" },
    { name: "안양", path: "/gyeonggi/anyang/" },
    { name: "역세권 안내" },
  ]} />

  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="hero__badge"><span class="dot"></span> 역세권 안내</span>
      <h1>
        <span class="kw">안양 지하철역</span>
        출장마사지 · 홈타이 역별 안내
      </h1>
      <p class="hero__sub">
        명학역, 석수역, 관악역, 인덕원역 등 안양의 주요 지하철역을 선택해 방문 가능 생활권과 예약 시 주의사항을 확인하세요.
      </p>
      <ul class="hero__points">
        <li>만안구·동안구 전역 역세권</li>
        <li>1호선·4호선 주요 역 안내</li>
        <li>정확한 도착 방법 안내</li>
      </ul>
      <div class="hero__cta">
        <a class="btn btn--cta" href={SITE.phoneHref}>전화예약 {SITE.phone}</a>
        <a class="btn btn--line" href="#stations">역별 상세 정보 보기</a>
        <a class="btn btn--line" href="/gyeonggi/anyang/">동별 안내 보기</a>
      </div>
    </div>
  </section>

  <!-- 역세권 이용 안내 -->
  <section class="section" style="padding-top:32px">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">역세권 이용 안내</span>
        <h2 class="section__title">안양 역세권에서 예약 전 확인사항</h2>
      </div>
      <div class="prose" style="line-height:1.85">
        <p>
          안양 역세권에서 출장마사지·홈타이를 예약할 때는 단순히 가까운 역 이름만으로는 부족합니다. 각 역의 세부 생활권, 차량 접근성, 건물 출입 방식이 모두 다르기 때문입니다. 명학역·석수역·관악역은 만안구 원도심과 외곽 지역의 거점이며, 인덕원역은 동안구 신도시의 중심입니다.
        </p>
        <p>
          예약 시에는 정확한 행정동(구), 도로명 주소, 건물명(아파트단지명·오피스텔명)을 명시해 주시기 바랍니다. 특히 시간대별 혼잡도가 다르므로, 방문 가능한 정확한 시간을 미리 확인하고 예약하시면 도착이 한결 수월합니다.
        </p>
      </div>
    </div>
  </section>

  <!-- 역별 상세 안내 -->
  <section class="section section--soft" id="stations">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">역별 상세 안내</span>
        <h2 class="section__title">안양 주요 지하철역</h2>
        <p class="section__lead">
          각 역의 위치, 인접 생활권, 방문 시 주의사항을 확인하고 상세 정보를 보세요.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
        {
          anyangStations.map((station) => (
            <a
              href={`/gyeonggi/anyang/station/${station.stationSlug}/`}
              style="padding:24px;border:1px solid #e0e0e0;border-radius:8px;text-decoration:none;transition:all 0.2s;cursor:pointer;display:flex;flex-direction:column;gap:12px"
            >
              <div>
                <div style="font-weight:bold;margin-bottom:4px;font-size:1.3rem">{station.stationName}</div>
                <div style="font-size:0.85rem;color:#666">{station.transferLines?.join(", ")}</div>
              </div>
              <p style="font-size:0.95rem;color:#44506a;margin:0;line-height:1.6">{station.contentFocus}</p>
              <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:auto">
                {station.nearbyAreas?.slice(0, 3).map((area) => (
                  <span style="font-size:0.85rem;padding:4px 8px;background:#f5f5f5;border-radius:4px;color:#666">{area}</span>
                ))}
              </div>
              <div style="font-size:0.9rem;color:#1f6feb;font-weight:600;margin-top:8px">상세보기 →</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 역세권별 특징 -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">역세권 특징</span>
        <h2 class="section__title">안양 역세권의 특징과 구분</h2>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px">
        <div>
          <h3 style="margin-bottom:16px;font-size:1.1rem;color:#0a1730">1호선 역 (만안구)</h3>
          <p style="line-height:1.8;color:#44506a;margin:0">
            명학역, 석수역, 관악역은 안양의 원도심과 외곽을 연결하는 1호선 역입니다. 각 역은 서로 다른 생활권의 거점이며, 차량 이동 중심의 지역입니다. 정확한 주소 확인이 가장 중요합니다.
          </p>
        </div>
        <div>
          <h3 style="margin-bottom:16px;font-size:1.1rem;color:#0a1730">4호선 역 (동안구)</h3>
          <p style="line-height:1.8;color:#44506a;margin:0">
            인덕원역은 동안구 신도시의 교통 중심입니다. 현대적 도시 계획에 따른 아파트 단지와 대형 상업시설이 밀집되어 있으며, 대중교통과 차량 접근성이 모두 우수합니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 코스 요금 -->
  <PriceTable areaLabel="안양 역세권" />

  <!-- 예약 팁 -->
  <section class="section section--soft">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">예약 팁</span>
        <h2 class="section__title">안양 역세권 예약 시 효과적인 정보 전달 방법</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px">
        <div style="padding:24px;background:#fff;border:1px solid #e6e9ef;border-radius:8px">
          <h3 style="margin:0 0 12px 0;font-size:1.05rem">1단계: 행정동 확인</h3>
          <p style="margin:0;color:#44506a;font-size:0.95rem">
            예약 주소의 정확한 동(박달동, 석수동 등)을 먼저 확인하세요. 같은 역세권이라도 동에 따라 도착 시간이 크게 다릅니다.
          </p>
        </div>
        <div style="padding:24px;background:#fff;border:1px solid #e6e9ef;border-radius:8px">
          <h3 style="margin:0 0 12px 0;font-size:1.05rem">2단계: 건물명 제시</h3>
          <p style="margin:0;color:#44506a;font-size:0.95rem">
            아파트 단지명, 오피스텔 정확한 주소, 또는 가까운 상가명을 함께 알려주세요. 도로명 주소도 함께 있으면 더 정확합니다.
          </p>
        </div>
        <div style="padding:24px;background:#fff;border:1px solid #e6e9ef;border-radius:8px">
          <h3 style="margin:0 0 12px 0;font-size:1.05rem">3단계: 시간 확인</h3>
          <p style="margin:0;color:#44506a;font-size:0.95rem">
            역세권마다 시간대별 혼잡도가 다릅니다. 예약 전 정확한 도착 가능 시간을 문의하고 최종 확정하세요.
          </p>
        </div>
        <div style="padding:24px;background:#fff;border:1px solid #e6e9ef;border-radius:8px">
          <h3 style="margin:0 0 12px 0;font-size:1.05rem">4단계: 추가비용 확인</h3>
          <p style="margin:0;color:#44506a;font-size:0.95rem">
            외곽 지역 방문 시 추가 이동비가 발생할 수 있습니다. 예약 시 기본 요금과 별도의 추가 비용 여부를 명확히 확인하세요.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
